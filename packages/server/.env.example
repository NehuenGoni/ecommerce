MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=4000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Resend
RESEND_API_KEY=

# Anthropic (extracción de facturas de proveedor). Sin API key, la feature
# queda deshabilitada. Se factura por tokens en console.anthropic.com --
# cuenta y saldo distintos de una suscripción de Claude Code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium

# Pricing por defecto al importar una factura: margen sobre el costo y paso
# de redondeo hacia arriba del precio de venta calculado (en centavos).
DEFAULT_MARGIN_PCT=60
PRICE_ROUNDING_STEP=10000

# Frontend URL (para CORS y links en emails)
CLIENT_URL=http://localhost:5173

# URL pública del server (dominio de Fly.io en producción), usada para que
# Mercado Pago pueda notificar el webhook de pago. Vacío en desarrollo local.
SERVER_URL=
