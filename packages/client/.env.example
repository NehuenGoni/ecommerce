# Relativo a propósito: el dev server de Vite proxya /api hacia el backend
# (ver vite.config.ts) y en producción lo hace el rewrite de vercel.json.
# Así el navegador nunca ve un origen distinto y la cookie del refresh token
# no cae en el bloqueo de cookies de terceros. No usar una URL absoluta acá.
VITE_API_URL=/api
VITE_MP_PUBLIC_KEY=
